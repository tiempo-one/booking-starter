# Copy to .env.local. Never commit .env.local.

# A Tiempo test key (tpt_...) from https://tiempo.one/dashboard
TIEMPO_API_KEY=

# Written by npm run setup
# TIEMPO_ACCOUNT_ID=
# TIEMPO_BARBERS=

# Optional: Tiempo webhooks, from the endpoint you register (tpw_...)
TIEMPO_WEBHOOK_SECRET=

# Optional: Stripe. Leave blank to use the built-in test payment page.
# Use test keys (sk_test_...) while you build.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: this app's public URL, for Stripe's return links. Defaults to the Vercel URL, then localhost.
APP_URL=
